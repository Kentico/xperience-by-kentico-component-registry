<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.6.0" />
    <!-- Aspire 13.6.1 references vulnerable MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h). -->
    <PackageVersion Include="MessagePack" Version="2.5.303" />
    <!-- Pin the new AppHost dependency without changing existing Xperience projects. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" Condition="'$(MSBuildProjectName)' == 'AppHost'" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Kentico.Xperience.Admin" Version="31.9.2" />
    <PackageVersion Include="Kentico.Xperience.WebApp" Version="31.9.2" />
    <PackageVersion Include="kentico.xperience.azurestorage" Version="31.9.2" />
    <PackageVersion Include="kentico.xperience.imageprocessing" Version="31.9.2" />
    <PackageVersion Include="kentico.xperience.managementapi" Version="31.9.2" />
    <PackageVersion Include="kentico.xperience.mjml" Version="31.9.2" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>
</Project>